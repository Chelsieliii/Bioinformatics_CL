#Sort, deduplicate, and remove blacklist after alignment

#for one file
#!/bin/bash
#PBS -lwalltime=09:00:00
#PBS -lselect=1:ncpus=127:mem=900gb

module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env   #samtools, bedtools, picard, deeptools were installed under align_env

set -e  #this stops the job when one command fails

cd $PBS_O_WORKDIR

filename="$PBS_O_WORKDIR/aligned_trimmed_CL2_1_EKDL250035182-1A_23GKKKLT4_L7.sam"
name=`basename $filename .sam` 
echo $name

samtools view -F 2308 -b -q 10 "$filename" > "$name.bam"
echo "sam to bam done"
samtools sort -o "$name.sort.bam" -T "temp_$name" "$name.bam"
echo "sort done"
picard AddOrReplaceReadGroups \
    -I "$name.sort.bam" \
    -O "rg_added_$name.sort.bam" \
    -RGID "$name" \
    -RGLB "$name" \
    -RGPL ILLUMINA \ 
    -RGPU unit1 \
    -RGSM "$name"
#Here we add a step of add read groups to the bam file. This is required for picard remove duplicates to recognise the files. 
#If samples are treated separately (i.e.not technical replicates), RGID, RGLB, and RGSM need to be unique for each file.

#Loop through all sam files in the folder--sort and add read groups
#!/bin/bash
#PBS -lwalltime=09:00:00
#PBS -lselect=1:ncpus=127:mem=900gb

module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env

set -e
cd $PBS_O_WORKDIR

for file in $PBS_O_WORKDIR/*.sam
do
name=`basename $file .sam` 
echo $name
samtools view -F 2308 -b -q 10 "$file" > $name.bam
echo "sam to bam done"
samtools sort -o "$name.sort.bam" -T "temp_$name" "$name.bam"
echo "sort done"
picard AddOrReplaceReadGroups \
I="$name.sort.bam" \
O="rg_added_$name.sort.bam" \
RGID="$name" \
RGLB="$name" \
RGPL=ILLUMINA \
RGPU=unit1 \
RGSM="$name"
echo "added rg"

done

#check if read groups were successfully added after
samtools view -H filename.sort.bam | grep '^@RG'

#Deduplication, remove blackblisted region and indexing
#for one file
#!/bin/bash
#PBS -lwalltime=72:00:00
#PBS -lselect=1:ncpus=64:mem=450gb  #Here one job takes ~10 min, use the medium queue

set -e
cd "$PBS_O_WORKDIR"
module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env

test_sample="$PBS_O_WORKDIR/rg_changed_aligned_trimmed_CL2_1_EKDL250035182-1A_23GKKKLT4_L7.sort.bam"
name=`basename $test_sample .sort.bam` 
echo $name
picard MarkDuplicates -REMOVE_DUPLICATES TRUE -I $test_sample -O $name.dedup.sort.bam -M $name.metrics.txt
echo "remove duplicates"
bedtools intersect -v -abam $name.dedup.sort.bam -b '/rds/general/project/diantonio/live/tools/blacklisted_regions/hg38-blacklist.v2.bed' > $name.bl.dedup.sort.bam
echo "remove blacklist"
samtools index $name.bl.dedup.sort.bam
echo "index bam file"
rm $name.bam $name.sort.bam $name.dedup.sort.bam
echo "remove process files"
#Check the metrics txt file afterwards for percent_duplicates, it should be 0. 

#To check if there's still duplicate left in the file. 
samtools view -F 1024 samplename.bl.dedup.sort.bam | wc -l

