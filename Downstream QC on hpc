#Plot correleation heatmap
#!/bin/bash
#PBS -lwalltime=24:00:00
#PBS -lselect=1:ncpus=128:mem=900gb
set -e
cd "$PBS_O_WORKDIR"
module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate align_env
plotCorrelation -in /rds/general/project/diantonio/live/Chelsie/CTR_astro_sequencing_270126/X204SC25120570-Z01-F001/01.RawData/All_tech_reps/trimmed/multibam_results_bin500.npz \ #The npz file generated from multibamsummary
                -c pearson \ #normalisation method. There is also spearman. Check documentation for more detail.
                -p heatmap \ #output format
                -o correlation_heatmap_pearson_withclustering.pdf \ #output file name
                -T "Correlation Heatmap for CTR Astrocytes G4 ChIP-seq (Pearson)" \ #Title name
                --outFileCorMatrix correlation_matrix_pearson_withclustering.tab \ #generate an output matrix file
                -min -1 \ #range of scale bar
                -max 1 \
                --plotNumbers #include correlation score on every square
