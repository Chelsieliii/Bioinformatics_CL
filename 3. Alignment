#alignment for one file

#!/bin/bash
#PBS -lwalltime=09:00:00
#PBS -lselect=1:ncpus=127:mem=900gb

cd "$PBS_O_WORKDIR"

echo "PWD is: $PWD"
echo "PBS_O_WORKDIR is: $PBS_O_WORKDIR"   #not necessary, just to check where the working directory is in case files are gone missing. 

module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate base  #bowtie2 was downloaded into the base environment. If in different environment activate the environment bowtie2 is in. 

REF="/rds/general/project/diantonio/live/tools/genomes/hg38_ucsc/hg38"

read_1="$PBS_O_WORKDIR/trimmed_CL2_1_EKDL250035182-1A_23GKKKLT4_L7.1.fq"
read_2="$PBS_O_WORKDIR/trimmed_CL2_1_EKDL250035182-1A_23GKKKLT4_L7.2.fq"

sample_name=$(basename "$read_1" | sed 's/\.1\.fq$//')
echo $sample_name

bowtie2 -x $REF -1 "$read_1" -2 "$read_2" -S "aligned_${sample_name}.sam" 2> "summary_${sample_name}.txt"

#Alignment for multiple files (loop through all fq files in the folder)
#!/bin/bash
#PBS -lwalltime=30:00:00   #Can change the walltime depending on number of files running
#PBS -lselect=1:ncpus=128:mem=900gb   #choose job type depending on number of files running. Alignment takes a lot of time so can choose more cpu to get faster.
cd "$PBS_O_WORKDIR"

module load miniforge/3
eval "$(/rds/general/user/xl1720/home/miniforge3/bin/conda shell.bash hook)"
conda activate base

REF="/rds/general/project/diantonio/live/tools/genomes/hg38_ucsc/hg38"

READ_DIR="/rds/general/project/diantonio/live/Chelsie/CTR_astro_sequencing_270126/X204SC25120570-Z01-F001/01.RawData/All_tech_reps/trimmed"

for read_1 in "$READ_DIR"/*.1.fq
do
read_2="${read_1/.1.fq/.2.fq}"  #take the corresponding read 2 file. Note here the file must end in .1.fq
echo $read_2  #check if it's the correct file

sample_name=$(basename "$read_1" | sed 's/\.1\.fq$//')  #extract file name before .1.fq as output file name
echo $sample_name

bowtie2 -x $REF -1 "$read_1" -2 "$read_2" -S "aligned_${sample_name}.sam" 2> "summary_${sample_name}.txt"
done
